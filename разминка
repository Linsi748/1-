// Метод умножения двух целых чисел через битовые сдвиги 
import java.util.Scanner;

public class Main {
    public static int umnozhenie(int chislo1, int chislo2) {
        int rezultat = 0;
        int mnozhitel = chislo2;   // второй множитель будем делить пополам
        int mnozhimoe = chislo1;   // первый множитель будем удваивать

        while (mnozhitel > 0) {
            // Если текущий множитель нечётный, добавляем множимое к результату
            if (mnozhitel % 2 == 1) {
                rezultat += mnozhimoe;
            }
            // Удваиваем множимое и делим множитель нацело на 2
            mnozhimoe += mnozhimoe;   // то же самое, что mnozhimoe * 2
            mnozhitel /= 2;
        }

        return rezultat;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Введите первое число: ");
        int pervyy = scanner.nextInt();

        System.out.print("Введите второе число: ");
        int vtoroy = scanner.nextInt();

        // Вычисляем произведение
        int proizvedenie = umnozhenie(pervyy, vtoroy);
        System.out.println("Результат умножения: " + proizvedenie);

        scanner.close();
    }
}

