import java.io.FileWriter;
import java.util.regex.*;
import java.io.File;
import java.io.IOException;

class Main {
    public static void main(String[] args) {
        File newfile = new File("My IP.txt");
        try {
            boolean created = newfile.createNewFile();
            if (created) {
                System.out.println("File has been created");
            } else {
                System.out.println("File already exists");
            }
        } catch (IOException ex) {
            System.out.println("ERROR: " + ex.getMessage());
        }
        System.out.println("File name: " + newfile.getName());

        
        String txt = " IP-адреса: 192.168.1.1, 8.8.8.8, 255.255.255.255, 300.10.20.30, 172.16.0.1, 999.88.77.66, 10.0.0.1, 127.0.0.1, 400.50.60.70, 198.51.100.0";

       
        String reg = "\\b(\\d|\\d\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|\\d\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|\\d\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|\\d\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\b";

        Pattern p = Pattern.compile(reg);
        Matcher m = p.matcher(txt);

        System.out.println("Корректный IP адрес:");
        try (FileWriter fw = new FileWriter(newfile)) {
            if (m.find()) {  
                String ip = m.group();
                System.out.println(ip);
                fw.write("Верный IP адрес:\n" + ip + "\n");
            } else {
                System.out.println("Не найдено");
                fw.write("Верных IP адресов не найдено");
            }
        } catch (IOException ex) {
            System.out.println("Ошибка: " + ex.getMessage());
        }
    }
}
