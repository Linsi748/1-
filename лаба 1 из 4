import java.util.Scanner

fun main() {
    val scan = Scanner(System.`in`)

    val N: Int = scan.nextInt()
    val x: Double = scan.nextDouble()

    var sum: Double = 0.0

    for (i in 0..N) {
        sum += Math.pow(-1.0, i.toDouble()) *
                Math.pow(x, i.toDouble()) /
                factorial(i)
    }

    println(sum)
}

fun factorial(a: Int): Int {
    var col = 1

    for (j in 1..a) {
        col *= j
    }

    return col
}
