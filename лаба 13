interface Product{
    void nameProduct();
    void priceProduct();
    void ratingProduct();
}

class classProduct implements Product{
    String name;
    int price;
    double rating;

    classProduct(String name, int price,double rating) {
        this.name = name;
        this.price = price;
        this.rating = rating;
    }

    public void nameProduct() {
        System.out.println("Продукт:"+name);
    }
    public void priceProduct(){
        System.out.println("Стоимость:"+price);
    }
    public void ratingProduct(){
        System.out.println("Рейтинг:"+rating);
    }

}
