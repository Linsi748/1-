import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = 1000;
        int[] a = new int[n];
        
        // Считываем последовательность
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        
        int maxR = -1;
        
        // Перебираем все пары различных элементов
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int product = a[i] * a[j];
                
                // Проверяем: кратно 14 и больше текущего максимума
                if (product % 14 == 0 && product > maxR) {
                    maxR = product;
                }
            }
        }
        
        System.out.println(maxR);
    }
}
